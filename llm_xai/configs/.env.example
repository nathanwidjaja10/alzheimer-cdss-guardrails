# Copy to `.env` when needed. The main path uses no cloud keys (fully local inference).

# Ollama host (the default suits a local installation)
OLLAMA_HOST=http://localhost:11434

# Local salt for hashing session ids. Used only if the optional cloud path is enabled;
# unused while inference is local.
LLMXAI_HASH_SALT=replace-with-a-random-local-string

# Cloud keys: leave empty unless the cloud path is enabled (requires ethics clearance,
# a data-use agreement and a written zero-data-retention agreement).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
